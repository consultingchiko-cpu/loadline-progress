{
  "name": "loadline-progress",
  "version": "0.2.1",
  "description": "A tiny, dependency-free progress bar with modern ESM and TypeScript packaging",
  "license": "MIT",
  "author": "Loadline contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/consultingchiko-cpu/loadline-progress.git"
  },
  "homepage": "https://github.com/consultingchiko-cpu/loadline-progress#readme",
  "bugs": {
    "url": "https://github.com/consultingchiko-cpu/loadline-progress/issues"
  },
  "keywords": [
    "progress-bar",
    "loading-bar",
    "frontend",
    "typescript",
    "esm",
    "accessibility"
  ],
  "engines": {
    "node": ">=14"
  },
  "main": "./src/loadline.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/loadline.cjs",
      "default": "./src/index.mjs"
    },
    "./style.css": "./src/loadline.css",
    "./integrations/react": "./integrations/react.mjs",
    "./integrations/vue": "./integrations/vue.mjs",
    "./integrations/svelte": "./integrations/svelte.mjs"
  },
  "files": [
    "src",
    "types",
    "integrations",
    "License.md",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "mocha test/*.test.js",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/basic.js",
    "verify": "npm test && npm run typecheck && npm audit --omit=dev",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "chai": "^5.1.0",
    "jquery": "^3.7.1",
    "jsdom": "^24.1.3",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  }
}
